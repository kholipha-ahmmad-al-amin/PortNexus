# PortNexus Enterprise Trade Intelligence & L/C Audit Engine
# Example Environment Configuration

# Server Port & Mode
PORT=3000
NODE_ENV="development"

# Application Settings
APP_NAME="PortNexus"
APP_DESCRIPTION="Autonomous Cross-Border Trade Compliance, Customs HS-Code Engine & L/C Discrepancy Auditor"

# Service credentials are backend-only. Never add these to public/ files.
REQUIRE_ORG_API_KEY="true"
PERSIST_AUDIT_EVIDENCE="false"
PERSIST_DOCUMENT_METADATA="false"
CORS_ALLOWED_ORIGINS="https://portnexus.equisaas-bd.com"
PUBLIC_BASE_URL="https://portnexus.equisaas-bd.com"

# Generate a unique random value of at least 32 bytes and store it in the secret manager.
CERTIFICATE_SIGNING_SECRET=""

# ─── PILLAR 1: Gemini Multimodal Document AI OCR ────────────────────────────
# Get your free API key at: https://aistudio.google.com/apikey
# If left blank, Tesseract can process supported image files locally. Scanned PDFs need a page renderer.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# ─── PILLAR 4: Supabase Persistent Database ─────────────────────────────────
# Supabase PostgreSQL database credentials
SUPABASE_URL="https://your-project.supabase.co"
# Server-only service role key. Required for production backend access and never sent to clients.
SUPABASE_SERVICE_ROLE_KEY=""
# Optional for local development only. Do not use this for production writes.
SUPABASE_ANON_KEY=""
